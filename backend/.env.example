# --- Unify Platform API ---
SERVICE_NAME=unify-platform-api
SERVICE_VERSION=1.0.0
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# MongoDB (Motor)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=unify_platform

# JWT
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000

# Redis (Phase 2+ cache — container provisioned now)
REDIS_URL=redis://localhost:6379/0

# Storage / Payments (Phase 2+ — config-ready placeholders)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Bootstrap super admin (created on startup if missing)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@unify.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=Admin@12345
